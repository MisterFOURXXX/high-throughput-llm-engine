# ============================================
# Dockerfile.multinode
# Multi-node Docker image for NCCL experiments
# ============================================

FROM nvidia/cuda:12.4.0-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:$PYTHONPATH

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    curl \
    git \
    libcurl4-openssl-dev \
    nlohmann-json3-dev \
    python3 \
    python3-pip \
    python3-venv \
    wget \
    openmpi-bin \
    openmpi-common \
    libnccl2 \
    libnccl-dev \
    && rm -rf /var/lib/apt/lists/*

# Create symlinks for Python
RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

# Set working directory
WORKDIR /app

# Copy requirements first
COPY requirements.txt .

# Install Python dependencies
RUN pip3 install --no-cache-dir -r requirements.txt

# Install additional dependencies
RUN pip3 install --no-cache-dir \
    kubernetes \
    pyyaml \
    pandas \
    numpy \
    matplotlib \
    seaborn \
    boto3

# Copy the project
COPY . .

# Build C++ load generator
RUN mkdir -p benchmarks/build && \
    cd benchmarks/build && \
    cmake .. && \
    make

# Create necessary directories
RUN mkdir -p artifacts/nccl_traces

# Set NCCL environment variables
ENV NCCL_DEBUG=INFO
ENV NCCL_DEBUG_SUBSYS=INIT,COLL,ENV
ENV NCCL_LOGFILE=/var/log/nccl_trace.log
ENV NCCL_SOCKET_IFNAME=eth0

# Default command
CMD ["python3", "scripts/run_simulation.py", "--nodes", "2", "--gpus-per-node", "4"]