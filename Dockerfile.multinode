# ============================================
# Dockerfile.multinode
# Multi-node Docker image for Oracle Cloud NCCL experiments
# ============================================

FROM nvidia/cuda:12.4.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:$PYTHONPATH

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    curl \
    git \
    libcurl4-openssl-dev \
    nlohmann-json3-dev \
    python3 \
    python3-pip \
    python3-venv \
    wget \
    unzip \
    openmpi-bin \
    openmpi-common \
    libnccl2 \
    libnccl-dev \
    && rm -rf /var/lib/apt/lists/*

# Symlinks
RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

WORKDIR /app

# Python dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt
RUN pip3 install --no-cache-dir kubernetes pyyaml pandas numpy matplotlib seaborn

# Copy project
COPY . .

# Build C++ load generator
RUN mkdir -p benchmarks/build && \
    cd benchmarks/build && \
    cmake .. && \
    make

# Directories
RUN mkdir -p artifacts/nccl_traces

# NCCL environment
ENV NCCL_DEBUG=INFO
ENV NCCL_DEBUG_SUBSYS=INIT,COLL,ENV
ENV NCCL_LOGFILE=/var/log/nccl_trace.log
ENV NCCL_SOCKET_IFNAME=eth0

CMD ["python3", "scripts/run_simulation.py", "--nodes", "2"]