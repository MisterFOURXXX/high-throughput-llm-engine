# AWS Credentials (required for Terraform multi‑node provisioning)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=eu-central-1

# SSH key name for EC2 instances (must exist in your AWS account)
SSH_KEY_NAME=your-ssh-key-name

# Optional: override ECR repository URL if you already have one
ECR_REPOSITORY_URL=your-ecr-repo-url

# NCCL debug settings (can be set here and sourced)
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,COLL,ENV
NCCL_LOGFILE=/var/log/nccl_trace.log