# ============================================
# OCI Credentials (only needed for deploy)
# ============================================
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaa...
OCI_USER_OCID=ocid1.user.oc1..aaaa...
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_PRIVATE_KEY_PATH=/home/ubuntu/high-throughput-llm-engine/key/ssh-key-2026-09-11.key
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaa...

# ============================================
# Container Registry (optional)
# ============================================
OCIR_REGISTRY=eu-frankfurt-1.ocir.io
OCIR_REPO_URL=eu-frankfurt-1.ocir.io/namespace/nccl-cluster

# ============================================
# NCCL Debug
# ============================================
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,COLL,ENV
NCCL_LOGFILE=/var/log/nccl_trace.log
NCCL_SOCKET_IFNAME=eth0